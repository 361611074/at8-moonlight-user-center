msgstr "头像库功能未启用。"

msgid "The password contains characters that are not allowed."
msgstr "密码中包含不允许的字符。"

msgid "The redirect address was not a valid URL, so it was cleared."
msgstr "重定向地址不是有效的网址，已将其清空。"

msgid "The security check failed. Please reload the page and try again."
msgstr "安全校验失败，请刷新页面后重试。"

msgid "The two new passwords do not match."
msgstr "两次输入的新密码不一致。"

msgid "This is the name shown publicly with your posts and comments."
msgstr "该名称会公开显示在您的文章和评论旁。"

msgid "This plugin does not send any data to an external service, does not embed third-party trackers and does not use cookies of its own. Sign-in sessions use the standard WordPress cookies."
msgstr "本插件不会向任何外部服务发送数据，不内嵌第三方跟踪代码，也不使用自己的 Cookie。登录状态使用 WordPress 标准 Cookie。"

msgid "This site uses Moonlight User Center to provide front-end login, registration, password recovery and a personal account area."
msgstr "本站使用「漫步白月光用户中心」提供前台登录、注册、找回密码和个人中心功能。"

msgid "Too many attempts. Please wait a moment and try again."
msgstr "尝试过于频繁，请稍后再试。"

msgid "Uninstall"
msgstr "卸载"

msgid "Update password"
msgstr "更新密码"

msgid "Use the default avatar"
msgstr "使用默认头像"

msgid "User Center"
msgstr "用户中心"

msgid "Username"
msgstr "用户名"

msgid "Username or Email Address"
msgstr "用户名或邮箱地址"

msgid "View Avatar"
msgstr "查看头像"

msgid "Website"
msgstr "个人网站"

msgid "When enabled, deleting the plugin removes its settings and the profile fields it added. WordPress user accounts, posts and comments are never removed."
msgstr "启用后，删除插件会一并清除其设置以及它添加的资料字段。WordPress 的用户账户、文章和评论不会被删除。"

msgid "When you register, the username, email address and password you submit are stored by WordPress. Your password is stored only as a one-way hash and is never visible to this site or to the plugin. If you complete your profile, the display name, nickname, first and last name, website address, biographical information and phone number you enter are stored on this site. If you pick an avatar, the identifier of the image you selected is stored with your account."
msgstr "注册时提交的用户名、邮箱地址和密码由 WordPress 保存。密码仅以单向散列形式存储，本站和本插件都无法查看。完善资料时填写的显示名称、昵称、名字、姓氏、网站地址、个人简介和手机号码会保存在本站。选择头像后，您所选图片的标识会与账户一并保存。"

msgid "You are already logged in. Go to %1$s or %2$s."
msgstr "您已登录，可前往%1$s或%2$s。"

msgid "You are not allowed to access this page."
msgstr "您无权访问此页面。"

msgid "You are not allowed to perform this action."
msgstr "您无权执行此操作。"

msgid "You are now logged in."
msgstr "登录成功。"

msgid "You can request an export of your personal data, or the erasure of the information listed above, at any time through the privacy tools on this site."
msgstr "您可以随时通过本站的隐私工具申请导出个人数据，或删除上述信息。"

