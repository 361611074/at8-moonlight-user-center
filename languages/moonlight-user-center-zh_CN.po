msgstr "该头像尚未设置图片。"

msgid "That avatar image could not be loaded."
msgstr "无法加载该头像图片。"

msgid "That avatar is not available."
msgstr "该头像不可用。"

msgid "That display name contains characters that are not allowed."
msgstr "该显示名称包含不允许的字符。"

msgid "That display name is too long."
msgstr "该显示名称过长。"

msgid "That email address is already registered."
msgstr "该邮箱地址已被注册。"

msgid "That email address is not valid."
msgstr "该邮箱地址格式不正确。"

msgid "That nickname contains characters that are not allowed."
msgstr "该昵称包含不允许的字符。"

msgid "That phone number is too long."
msgstr "该手机号码过长。"

msgid "That username contains invalid characters."
msgstr "该用户名包含无效字符。"

msgid "That username does not exist."
msgstr "该用户名不存在。"

msgid "That username is already taken."
msgstr "该用户名已被使用。"

msgid "That website address is not valid."
msgstr "该网站地址格式不正确。"

