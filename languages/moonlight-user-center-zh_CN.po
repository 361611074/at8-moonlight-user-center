msgstr "头像已恢复为默认。"

msgid "Your avatar has been updated."
msgstr "头像已更新。"

msgid "Your current password is incorrect."
msgstr "当前密码不正确。"

msgid "Your password has been changed."
msgstr "密码已修改。"

msgid "Your profile has been updated."
msgstr "资料已更新。"

